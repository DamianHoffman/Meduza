# Copy this file to voice-service/.env and fill in your key:
#   cp voice-service/.env.example voice-service/.env
#
# This service owns the ElevenLabs credential — app.py never sees it,
# it just calls this service's /tts endpoint.

# Required for real speech. Without it, /tts returns 503 (and the main
# app degrades gracefully — voice replies just silently don't play).
# Create a key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional. Any ElevenLabs voice_id. Defaults to a premade voice ("Rachel")
# if left blank. Browse voices: https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=

# Optional. Port this service listens on. app.py expects 8081 by default
# (see VOICE_SERVICE_URL in the root .env.example) — change both together.
PORT=8081

# Optional, for testing only. Points outbound requests at a mock server
# instead of the real ElevenLabs API. Leave unset for normal use.
# ELEVENLABS_BASE_URL=http://localhost:9999
